# Copy to .env and fill in real values before running docker compose.

ENVIRONMENT=development

POSTGRES_USER=nms
POSTGRES_PASSWORD=nms
POSTGRES_DB=nms
POSTGRES_PORT=5432

# Host port for the api container (default 8000). Override if something else on
# your machine already listens on 8000 -- e.g. API_PORT=8001. If you change this,
# also update README.md's documented URL, frontend/lib/cookies.ts's apiBase()
# fallback (both of which assume the default when running the frontend outside
# docker compose), AND NEXT_PUBLIC_API_WS_URL below -- the browser's WebSocket
# connects straight to this host port, so a mismatch fails silently (the socket
# never reaches the container at all, no server-side log line, just an endless
# client-side reconnect loop).
# API_PORT=8000

DATABASE_URL=postgresql+asyncpg://nms:nms@postgres:5432/nms
SYNC_DATABASE_URL=postgresql+psycopg2://nms:nms@postgres:5432/nms

REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Seeded on first boot if no users exist yet
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-immediately

MAX_CONCURRENT_POLLS=50
DISCOVERY_MAX_HOSTS=4096
DISCOVERY_RATE_PPS=20

# Server-side only -- the frontend's route-handler proxy talks to the API through
# this URL; the browser never calls it directly (see frontend/lib/cookies.ts).
API_INTERNAL_BASE_URL=http://api:8000/api/v1

# The one exception to the above: Next.js Route Handlers can't proxy a WebSocket
# upgrade, so the browser opens the live-updates socket directly to the API's public
# URL (baked into the frontend build -- see frontend/Dockerfile). Auth still never
# exposes the JWT to the browser: it's a short-lived one-time ticket instead (see
# backend/app/api/routes/ws.py). In production this must point at a public wss://
# URL and the reverse proxy must forward that path to the api container.
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000
